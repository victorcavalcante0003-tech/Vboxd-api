generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  bio          String?
  avatarUrl    String?
  favfilmId    String
  createdAt    DateTime  @default(now())

  favfilm      Film      @relation(fields: [favfilmId], references: [id], onDelete: Cascade)
  logs         Log[]
  comments     Comment[]
  likes        Like[]
  watchlist    Watchlist[]

  following    Follow[]  @relation("Following")
  followers    Follow[]  @relation("Followers")
}

model Log {
  id        String    @id @default(uuid())
  filmId    String
  rate      Int
  content   String?
  authorId  String
  createdAt DateTime  @default(now())

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  film      Film      @relation(fields: [filmId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  logId     String
  authorId  String
  createdAt DateTime @default(now())

  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  logId     String
  userId    String
  createdAt DateTime @default(now())

  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([logId, userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Watchlist {
  id        String   @id @default(uuid())
  userId    String
  filmId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  film      Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@unique([userId, filmId])
}

model Film {
  id        String    @id @default(uuid())
  title     String
  year      Int
  poster    String
  synopsis  String
  director  String

  favoritedBy User[]
  logs        Log[]
  watchlist   Watchlist[]

}